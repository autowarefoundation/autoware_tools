    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /System1/Vehicle1
        - /Map1
        - /Map1/Lanelet2VectorMap1/Namespaces1
        - /Sensing1
        - /Sensing1/LiDAR1
        - /Sensing1/LiDAR1/ConcatenatePointCloud1
